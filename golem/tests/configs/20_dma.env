# DMA/流水重叠实验参数
: "${GOLEM_DMA_NODE_CHUNK_CREDITS:=84}"
: "${GOLEM_DMA_CREDIT_CHUNK_BYTES:=8192}"
: "${GOLEM_DMA_PARTIAL_CREDIT_ENABLE:=1}"
: "${GOLEM_DMA_RESPONSE_CHUNK_BYTES:=$GOLEM_DMA_CREDIT_CHUNK_BYTES}"
: "${GOLEM_DMA_RESPONSE_VN:=1}"
: "${GOLEM_DMA_SLOT_COUNT:=16}"
: "${GOLEM_DMA_PREFETCH_DEPTH:=8}"
: "${GOLEM_REQUEST_SCHEDULER_QUEUE_DEPTH:=4096}"
# : "${GOLEM_DMA_WINDOW_K_TILES:=4}"
: "${GOLEM_SCHED_SUBMIT_BATCH_SIZE:=1}"
: "${GOLEM_SCHED_DONE_BATCH_SIZE:=8}"
: "${GOLEM_SCHED_ISSUE_BUDGET:=8}"
: "${GOLEM_SCHED_SMOOTH_ENABLE:=0}"
: "${GOLEM_SCHED_READ_BW_BYTES_PER_CYCLE:=600}"
: "${GOLEM_SCHED_WRITE_BW_BYTES_PER_CYCLE:=40}"
: "${GOLEM_SCHED_TOKEN_BURST_BYTES:=65536}"
: "${GOLEM_WCP_STREAM_KTILE_WINDOWS:=0}"
: "${GOLEM_WCP_READY_REUSE_QUEUE:=0}"
: "${GOLEM_DMA_READ_RETRY_TICKS:=32}"
: "${GOLEM_DMA_READ_MAX_RETRIES:=8}"
: "${GOLEM_DMA_BURST_BYTES:=1024}"
: "${GOLEM_A_REUSE_N_TILES:=4}"
: "${GOLEM_B_REUSE_M_TILES:=4}"

# 每核 GM 窗口（与 local layout / DMA flag 相关）
: "${GOLEM_GLOBAL_STRIDE_KB:=512}"

export GOLEM_DMA_STAGGER_CYCLES
export GOLEM_DMA_OVERLAP
export GOLEM_CTRL_OVERLAP_AB
export GOLEM_DMA_NODE_CHUNK_CREDITS
export GOLEM_DMA_CREDIT_CHUNK_BYTES
export GOLEM_DMA_PARTIAL_CREDIT_ENABLE
export GOLEM_DMA_RESPONSE_CHUNK_BYTES
export GOLEM_DMA_RESPONSE_VN
export GOLEM_DMA_SLOT_COUNT
export GOLEM_DMA_PREFETCH_DEPTH
export GOLEM_REQUEST_SCHEDULER_QUEUE_DEPTH
export GOLEM_DMA_WINDOW_K_TILES
export GOLEM_SCHED_SUBMIT_BATCH_SIZE
export GOLEM_SCHED_DONE_BATCH_SIZE
export GOLEM_SCHED_ISSUE_BUDGET
export GOLEM_SCHED_SMOOTH_ENABLE
export GOLEM_SCHED_READ_BW_BYTES_PER_CYCLE
export GOLEM_SCHED_WRITE_BW_BYTES_PER_CYCLE
export GOLEM_SCHED_TOKEN_BURST_BYTES
export GOLEM_WCP_STREAM_KTILE_WINDOWS
export GOLEM_WCP_READY_REUSE_QUEUE
export GOLEM_DMA_READ_RETRY_TICKS
export GOLEM_DMA_READ_MAX_RETRIES
export GOLEM_DMA_BURST_BYTES
export GOLEM_A_REUSE_N_TILES
export GOLEM_B_REUSE_M_TILES
export GOLEM_GLOBAL_STRIDE_KB
