# 16-core 128x128 configuration
# Quick validation test with single-core softmax

# Matrix dimensions
export GOLEM_GEMM_M=128
export GOLEM_GEMM_N=128
export GOLEM_GEMM_K=128

# Tile sizes
export GOLEM_GEMM_BLOCK_M=64
export GOLEM_GEMM_BLOCK_N=64
export GOLEM_GEMM_BLOCK_K=64

# Multi-core GEMM
export GOLEM_TOTAL_CORES=16
export GOLEM_TOTAL_GEMM_CORES=16
export GOLEM_TOTAL_GROUPS=4

# Memory and topology (must satisfy: num_mem_nodes - total_groups <= mesh_dim_x)
# With 4 groups, we need mesh_dim_x >= 5 to place 9 memory nodes
export GOLEM_NUM_MEMORY_NODES=9
export GOLEM_MESH_DIM_X=5
export GOLEM_MESH_DIM_Y=5

# Softmax mode (single-core by default)
export GOLEM_SOFTMAX_MODE=single-core

# Enable group manager and control link for 16-core
export GOLEM_GROUP_MANAGER_ENABLE=1
export GOLEM_CTRL_LINK_ENABLE=1
